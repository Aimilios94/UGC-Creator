# UGC Ad Builder v2 — backend settings
# Copy to backend/.env and fill in. Never commit backend/.env.
# The app imports without any secret set; LLM_PROVIDER=mock and MEDIA_PROVIDER=mock need no keys.

# --- App ---
APP_ENV=local                      # local | prod
LOG_LEVEL=INFO

# --- Providers ---
LLM_PROVIDER=openai                # openai | anthropic | mock (OpenAI is the default until the M4 eval)
MEDIA_PROVIDER=fal                 # fal | mock (tests and CI always use mock)
VOICE_PROVIDER=openai              # openai | mock (voiceover; uses OPENAI_API_KEY)
STORAGE_PROVIDER=local             # local | gcs

# --- Keys (secrets) ---
OPENAI_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=                 # M4

# --- Models (a model is a config value) ---
LLM_MODEL=
IMAGE_MODEL=fal-ai/nano-banana/edit
VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
RENDER_SCENES=20                   # most shots rendered per ad (D32: the story sets the cuts; M1 leg was 1)
MOCK_PREVIEW=true                  # mock media shows your own pictures (local stack); tests use placeholders
TTS_MODEL=gpt-4o-mini-tts          # voiceover; OpenAI shuts it down on 6 Jan 2027 (D26)
TTS_VOICE=marin                    # default voice: marin | cedar | coral | onyx

# --- Database (Neon Postgres + pgvector, EU) ---
DATABASE_URL=                      # pooled connection (API and worker)
DATABASE_URL_DIRECT=               # direct connection (schema apply)
DB_CONNECT_TIMEOUT_S=20
DB_CONNECT_RETRIES=5               # Neon scales to zero; the first connection after idle is slow

# --- Storage ---
STORAGE_LOCAL_DIR=./data
GCS_BUCKET=
GCP_PROJECT_ID=ugc-ad-builder
GCP_REGION=europe-west4
SIGNED_URL_TTL_SECONDS=900

# --- Worker ---
JOB_RUNNER=local                   # local (Compose worker loop) | cloudrun (Cloud Run Job)
CLOUD_RUN_JOB_NAME=
MAX_JOB_ATTEMPTS=2

# --- Money (everything the user sets or sees is in EUR) ---
JOB_COST_CAP_EUR=5                 # D31: safety limit only; the fullest ad is about 3.50 EUR (D2 M2 was 1.75)
DAILY_SPEND_LIMIT_EUR=10           # D31: two full ads per day (D2 M2 was 4)
USD_TO_EUR_RATE=0.91               # ECB, 20 Nov 2026 (1 EUR = 1.0990 USD); providers bill in USD
DISPLAY_CURRENCY=EUR               # EUR | USD (Advanced settings)
DEMO_POT_EUR=                      # M4

# --- Access and uploads ---
ACCESS_CODES=                      # comma-separated; generation requires one (M1–M4)
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173

# --- Later milestones ---
RETENTION_DAYS=30                  # M2
ADMIN_TOKEN=                       # M2: cleanup + stale-job sweep endpoint (GitHub Actions secret)
SENTRY_DSN=                        # M2
EMAIL_ENABLED=false                # M3
RESEND_API_KEY=                    # M3
EMAIL_FROM=                        # M3
LANGSMITH_TRACING=false            # M4
LANGSMITH_API_KEY=                 # M4
LANGSMITH_PROJECT=                 # M4
IP_HASH_SECRET=                    # M4: daily salt = HMAC-SHA256(IP_HASH_SECRET, UTC date), so it rotates daily; only salted hashes are stored, never raw IPs
BATCH_TOKEN=                       # M5: scheduled batch endpoint (GitHub Actions secret)
