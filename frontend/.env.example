# UGC Ad Builder v2 — frontend settings
# Copy to frontend/.env. Every VITE_ value is public (bundled into the site): never put a secret here.

VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=                   # error reports (Sentry EU, project ugc-web); empty = off. A DSN is public by design.
